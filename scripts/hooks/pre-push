#!/usr/bin/env bash
# pre-push — ensures the version is bumped before pushing.
#
# Blocks if EITHER:
#   1. [Unreleased] in CHANGELOG.md has meaningful content, OR
#   2. src/ commits exist since the last version-bump commit (catches
#      devs who skip writing to [Unreleased] entirely)
#
# Run `npm run version:patch` (or minor/major) to bump, then push again.
# To skip: git push --no-verify  (not recommended)

ROOT="$(git rev-parse --show-toplevel)"
CHANGELOG="$ROOT/CHANGELOG.md"

# ── Guard: CHANGELOG must exist ───────────────────────────────────────
if [ ! -f "$CHANGELOG" ]; then
  echo ""
  echo "⚠  CHANGELOG.md not found. Create it before pushing."
  echo ""
  exit 1
fi

# ── Check 1: [Unreleased] has written content ─────────────────────────
unreleased_content=$(awk '/^## \[Unreleased\]/{found=1; next} found && /^---/{exit} found{print}' "$CHANGELOG")
meaningful=$(echo "$unreleased_content" | grep -v '^\s*$' | grep -v '^>' | grep -v '^### ')

# ── Check 2: src/ commits since last version-bump commit ─────────────
# Find the most recent commit that touched package.json (proxy for a version bump)
last_bump_commit=$(git log --oneline -- package.json | head -1 | awk '{print $1}')
commits_since_bump=""
if [ -n "$last_bump_commit" ]; then
  commits_since_bump=$(git log --oneline "$last_bump_commit"..HEAD -- src/ public/ 2>/dev/null \
    | grep -v 'chore:.*bump\|chore:.*stamp\|chore:.*changelog\|chore:.*version' \
    | head -1)
fi

needs_bump=0
reason=""

if [ -n "$meaningful" ]; then
  needs_bump=1
  reason="[Unreleased] in CHANGELOG.md has content that hasn't been versioned"
elif [ -n "$commits_since_bump" ]; then
  needs_bump=1
  reason="src/ changes exist since last version bump but version wasn't bumped"
fi

if [ "$needs_bump" -eq 1 ]; then
  echo ""
  echo "╔══════════════════════════════════════════════════════╗"
  echo "║  Push blocked — unreleased changes need a version   ║"
  echo "╚══════════════════════════════════════════════════════╝"
  echo ""
  echo "  Reason: $reason"
  echo ""
  if [ -n "$meaningful" ]; then
    echo "  [Unreleased] content:"
    echo "$meaningful" | head -8 | sed 's/^/    /'
    echo ""
  fi
  if [ -n "$commits_since_bump" ]; then
    echo "  Commits since last version bump:"
    git log --oneline "$last_bump_commit"..HEAD -- src/ public/ 2>/dev/null \
      | grep -v 'chore:.*bump\|chore:.*stamp\|chore:.*changelog\|chore:.*version' \
      | head -6 | sed 's/^/    /'
    echo ""
  fi
  echo "  Steps:"
  echo "    1. Add your changes to CHANGELOG.md under ### Added / Changed / Fixed"
  echo "    2. npm run version:patch   (bug fixes / small tweaks)"
  echo "       npm run version:minor   (new features)"
  echo "       npm run version:major   (breaking changes)"
  echo "    3. git add CHANGELOG.md package.json src/data/changelog.json"
  echo "    4. git commit -m \"chore: bump to vX.Y.Z\""
  echo "    5. git push"
  echo ""
  echo "  To skip (not recommended): git push --no-verify"
  echo ""
  exit 1
fi

echo "✓ Version is current — proceeding with push."
exit 0
